# Copy this file to `.env` in the same directory.
# Do not commit `.env`. Do not put real API keys in this file.
# LLM calls go through Orca Router only. Do not add provider keys for advice.
# Speech-to-text uses a separate OpenAI key on the backend. Never NEXT_PUBLIC_*.

# Required for live advice and requirements generation.
ORCAROUTER_API_KEY=

# Optional Orca Router settings. Defaults match Settings.
# Defaults are Orca Router free models (https://docs.orcarouter.ai/ja/routing/free-models).
# Named routing (orcarouter/free etc.) comes later; do not enable it here yet.
ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1
ORCAROUTER_DEFAULT_MODEL=deepseek/deepseek-v4-flash-free
ORCAROUTER_TIMEOUT_SECONDS=60.0
ORCAROUTER_REQUIREMENTS_MODEL=deepseek/deepseek-v4-flash-free
# Empty while staying on free models. -free slugs cannot be extra_body.models fallbacks.
ORCAROUTER_REQUIREMENTS_FALLBACK_MODELS=
ORCAROUTER_REQUIREMENTS_TIMEOUT_SECONDS=120.0

# Speech-to-text. Default provider is OpenAI GPT-Realtime-Whisper.
# Azure Speech is a later adapter behind STTService (STT_PROVIDER=azure fails closed).
STT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_STT_MODEL=gpt-realtime-whisper
OPENAI_STT_URL=wss://api.openai.com/v1/realtime
OPENAI_STT_LANGUAGE=ja
OPENAI_STT_DELAY=high
OPENAI_STT_TIMEOUT_SECONDS=30.0
AUDIO_SAMPLE_RATE=16000

# Optional process metadata.
APP_NAME=AI HACK APP1 API
APP_VERSION=0.1.0
DEBUG=false
