# Copy this file to `.env` in the same directory.
# Do not commit `.env`. Do not put real API keys in this file.
# LLM calls go through Orca Router only. Do not add provider keys.

# Required for live advice and requirements generation.
ORCAROUTER_API_KEY=

# Optional Orca Router settings. Defaults match Settings.
ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1
ORCAROUTER_DEFAULT_MODEL=openai/gpt-4o-mini
ORCAROUTER_TIMEOUT_SECONDS=60.0
ORCAROUTER_REQUIREMENTS_MODEL=anthropic/claude-3-5-sonnet
ORCAROUTER_REQUIREMENTS_FALLBACK_MODELS=openai/gpt-4o
ORCAROUTER_REQUIREMENTS_TIMEOUT_SECONDS=120.0

# Optional speech-to-text settings.
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=ja
AUDIO_SAMPLE_RATE=16000

# Optional process metadata.
APP_NAME=AI HACK APP1 API
APP_VERSION=0.1.0
DEBUG=false
